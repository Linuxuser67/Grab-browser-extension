{
  "manifest_version": 3,
  "name": "Grab",
  "version": "1.0.3",
  "description": "Send downloads and links to the Grab download manager.",
  "homepage_url": "https://github.com/Linuxuser67/Grab",
  "permissions": ["activeTab", "alarms", "contextMenus", "downloads", "storage"],
  "minimum_chrome_version": "102",
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Grab options",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "send-tab-to-grab": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Send the current tab to Grab."
    }
  }
}
