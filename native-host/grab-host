#!/usr/bin/env python3
"""Grab native messaging host.

Receives handoff URLs from the Grab browser extension via the Native
Messaging stdio protocol and launches the Grab desktop app through the
system's URI handler (xdg-open / gio open).

Only grab:// URLs are accepted; anything else is rejected without
executing anything. The URL is passed as a single argv element, never
through a shell.

Protocol (both directions): 4-byte little-endian length prefix followed
by a UTF-8 JSON payload.

Request:  {"url": "grab://https/example.com/file.zip"}
Response: {"success": true} or {"success": false, "error": "..."}
"""

import json
import shutil
import struct
import subprocess
import sys


GRAB_SCHEME = "grab://"
HOST_NAME = "io.github.linuxuser67.grab"


def read_message():
    raw_length = sys.stdin.buffer.read(4)
    if len(raw_length) < 4:
        return None
    length = struct.unpack("<I", raw_length)[0]
    if length == 0 or length > 1024 * 1024:
        return None
    raw = sys.stdin.buffer.read(length)
    if len(raw) < length:
        return None
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None


def write_message(payload):
    raw = json.dumps(payload).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(raw)))
    sys.stdout.buffer.write(raw)
    sys.stdout.buffer.flush()


def launch(url):
    """Hand the grab:// URL to the OS. Returns (ok, error)."""
    if not isinstance(url, str) or not url.startswith(GRAB_SCHEME):
        return False, "only grab:// URLs are accepted"
    # Prefer xdg-open; fall back to gio open. No shell, single argv.
    opener = shutil.which("xdg-open") or shutil.which("gio")
    if not opener:
        return False, "no URI opener found (xdg-open/gio)"
    try:
        if opener.endswith("gio"):
            subprocess.run(
                [opener, "open", url],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
        else:
            subprocess.run(
                [opener, url],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
    except (subprocess.SubprocessError, OSError) as exc:
        return False, str(exc)
    return True, ""


def main():
    while True:
        msg = read_message()
        if msg is None:
            break
        url = msg.get("url") if isinstance(msg, dict) else None
        ok, error = launch(url)
        if ok:
            write_message({"success": True})
        else:
            write_message({"success": False, "error": error})


if __name__ == "__main__":
    main()
